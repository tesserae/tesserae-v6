<quran.at_takwir.81.1>	بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ
<quran.at_takwir.81.2>	وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ
<quran.at_takwir.81.3>	وَإِذَا ٱلْجِبَالُ سُيِّرَتْ
<quran.at_takwir.81.4>	وَإِذَا ٱلْعِشَارُ عُطِّلَتْ
<quran.at_takwir.81.5>	وَإِذَا ٱلْوُحُوشُ حُشِرَتْ
<quran.at_takwir.81.6>	وَإِذَا ٱلْبِحَارُ سُجِّرَتْ
<quran.at_takwir.81.7>	وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ
<quran.at_takwir.81.8>	وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ
<quran.at_takwir.81.9>	بِأَىِّ ذَنۢبٍ قُتِلَتْ
<quran.at_takwir.81.10>	وَإِذَا ٱلصُّحُفُ نُشِرَتْ
<quran.at_takwir.81.11>	وَإِذَا ٱلسَّمَآءُ كُشِطَتْ
<quran.at_takwir.81.12>	وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ
<quran.at_takwir.81.13>	وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ
<quran.at_takwir.81.14>	عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ
<quran.at_takwir.81.15>	فَلَآ أُقْسِمُ بِٱلْخُنَّسِ
<quran.at_takwir.81.16>	ٱلْجَوَارِ ٱلْكُنَّسِ
<quran.at_takwir.81.17>	وَٱلَّيْلِ إِذَا عَسْعَسَ
<quran.at_takwir.81.18>	وَٱلصُّبْحِ إِذَا تَنَفَّسَ
<quran.at_takwir.81.19>	إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ
<quran.at_takwir.81.20>	ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ
<quran.at_takwir.81.21>	مُّطَاعٍ ثَمَّ أَمِينٍ
<quran.at_takwir.81.22>	وَمَا صَاحِبُكُم بِمَجْنُونٍ
<quran.at_takwir.81.23>	وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ
<quran.at_takwir.81.24>	وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ
<quran.at_takwir.81.25>	وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ
<quran.at_takwir.81.26>	فَأَيْنَ تَذْهَبُونَ
<quran.at_takwir.81.27>	إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ
<quran.at_takwir.81.28>	لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ
<quran.at_takwir.81.29>	وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ
