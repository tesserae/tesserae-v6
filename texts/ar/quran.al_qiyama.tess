<quran.al_qiyama.75.1>	بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ
<quran.al_qiyama.75.2>	وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ
<quran.al_qiyama.75.3>	أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ
<quran.al_qiyama.75.4>	بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ
<quran.al_qiyama.75.5>	بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ
<quran.al_qiyama.75.6>	يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ
<quran.al_qiyama.75.7>	فَإِذَا بَرِقَ ٱلْبَصَرُ
<quran.al_qiyama.75.8>	وَخَسَفَ ٱلْقَمَرُ
<quran.al_qiyama.75.9>	وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ
<quran.al_qiyama.75.10>	يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ
<quran.al_qiyama.75.11>	كَلَّا لَا وَزَرَ
<quran.al_qiyama.75.12>	إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ
<quran.al_qiyama.75.13>	يُنَبَّؤُا۟ ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ
<quran.al_qiyama.75.14>	بَلِ ٱلْإِنسَـٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ
<quran.al_qiyama.75.15>	وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ
<quran.al_qiyama.75.16>	لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ
<quran.al_qiyama.75.17>	إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ
<quran.al_qiyama.75.18>	فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ
<quran.al_qiyama.75.19>	ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ
<quran.al_qiyama.75.20>	كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ
<quran.al_qiyama.75.21>	وَتَذَرُونَ ٱلْـَٔاخِرَةَ
<quran.al_qiyama.75.22>	وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ
<quran.al_qiyama.75.23>	إِلَىٰ رَبِّهَا نَاظِرَةٌ
<quran.al_qiyama.75.24>	وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ
<quran.al_qiyama.75.25>	تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ
<quran.al_qiyama.75.26>	كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ
<quran.al_qiyama.75.27>	وَقِيلَ مَنْ ۜ رَاقٍ
<quran.al_qiyama.75.28>	وَظَنَّ أَنَّهُ ٱلْفِرَاقُ
<quran.al_qiyama.75.29>	وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ
<quran.al_qiyama.75.30>	إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ
<quran.al_qiyama.75.31>	فَلَا صَدَّقَ وَلَا صَلَّىٰ
<quran.al_qiyama.75.32>	وَلَـٰكِن كَذَّبَ وَتَوَلَّىٰ
<quran.al_qiyama.75.33>	ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ
<quran.al_qiyama.75.34>	أَوْلَىٰ لَكَ فَأَوْلَىٰ
<quran.al_qiyama.75.35>	ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ
<quran.al_qiyama.75.36>	أَيَحْسَبُ ٱلْإِنسَـٰنُ أَن يُتْرَكَ سُدًى
<quran.al_qiyama.75.37>	أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ
<quran.al_qiyama.75.38>	ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ
<quran.al_qiyama.75.39>	فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ
<quran.al_qiyama.75.40>	أَلَيْسَ ذَٰلِكَ بِقَـٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ
