<quran.abasa.80.1>	بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ
<quran.abasa.80.2>	أَن جَآءَهُ ٱلْأَعْمَىٰ
<quran.abasa.80.3>	وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ
<quran.abasa.80.4>	أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ
<quran.abasa.80.5>	أَمَّا مَنِ ٱسْتَغْنَىٰ
<quran.abasa.80.6>	فَأَنتَ لَهُۥ تَصَدَّىٰ
<quran.abasa.80.7>	وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ
<quran.abasa.80.8>	وَأَمَّا مَن جَآءَكَ يَسْعَىٰ
<quran.abasa.80.9>	وَهُوَ يَخْشَىٰ
<quran.abasa.80.10>	فَأَنتَ عَنْهُ تَلَهَّىٰ
<quran.abasa.80.11>	كَلَّآ إِنَّهَا تَذْكِرَةٌ
<quran.abasa.80.12>	فَمَن شَآءَ ذَكَرَهُۥ
<quran.abasa.80.13>	فِى صُحُفٍ مُّكَرَّمَةٍ
<quran.abasa.80.14>	مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ
<quran.abasa.80.15>	بِأَيْدِى سَفَرَةٍ
<quran.abasa.80.16>	كِرَامٍۭ بَرَرَةٍ
<quran.abasa.80.17>	قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ
<quran.abasa.80.18>	مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ
<quran.abasa.80.19>	مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ
<quran.abasa.80.20>	ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ
<quran.abasa.80.21>	ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ
<quran.abasa.80.22>	ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ
<quran.abasa.80.23>	كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ
<quran.abasa.80.24>	فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ
<quran.abasa.80.25>	أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا
<quran.abasa.80.26>	ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا
<quran.abasa.80.27>	فَأَنۢبَتْنَا فِيهَا حَبًّا
<quran.abasa.80.28>	وَعِنَبًا وَقَضْبًا
<quran.abasa.80.29>	وَزَيْتُونًا وَنَخْلًا
<quran.abasa.80.30>	وَحَدَآئِقَ غُلْبًا
<quran.abasa.80.31>	وَفَـٰكِهَةً وَأَبًّا
<quran.abasa.80.32>	مَّتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ
<quran.abasa.80.33>	فَإِذَا جَآءَتِ ٱلصَّآخَّةُ
<quran.abasa.80.34>	يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ
<quran.abasa.80.35>	وَأُمِّهِۦ وَأَبِيهِ
<quran.abasa.80.36>	وَصَـٰحِبَتِهِۦ وَبَنِيهِ
<quran.abasa.80.37>	لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ
<quran.abasa.80.38>	وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ
<quran.abasa.80.39>	ضَاحِكَةٌ مُّسْتَبْشِرَةٌ
<quran.abasa.80.40>	وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ
<quran.abasa.80.41>	تَرْهَقُهَا قَتَرَةٌ
<quran.abasa.80.42>	أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ
