<quran.al_layl.92.1>	بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ
<quran.al_layl.92.2>	وَٱلنَّهَارِ إِذَا تَجَلَّىٰ
<quran.al_layl.92.3>	وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ
<quran.al_layl.92.4>	إِنَّ سَعْيَكُمْ لَشَتَّىٰ
<quran.al_layl.92.5>	فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ
<quran.al_layl.92.6>	وَصَدَّقَ بِٱلْحُسْنَىٰ
<quran.al_layl.92.7>	فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ
<quran.al_layl.92.8>	وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ
<quran.al_layl.92.9>	وَكَذَّبَ بِٱلْحُسْنَىٰ
<quran.al_layl.92.10>	فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ
<quran.al_layl.92.11>	وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ
<quran.al_layl.92.12>	إِنَّ عَلَيْنَا لَلْهُدَىٰ
<quran.al_layl.92.13>	وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ
<quran.al_layl.92.14>	فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ
<quran.al_layl.92.15>	لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى
<quran.al_layl.92.16>	ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ
<quran.al_layl.92.17>	وَسَيُجَنَّبُهَا ٱلْأَتْقَى
<quran.al_layl.92.18>	ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ
<quran.al_layl.92.19>	وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ
<quran.al_layl.92.20>	إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ
<quran.al_layl.92.21>	وَلَسَوْفَ يَرْضَىٰ
