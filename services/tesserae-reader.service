[Unit]
Description=Tesserae Theme Search reader (trained MiniLM cross-encoder)
Documentation=file:///home/ncoffee/tesserae-preview/services/reader_server.py
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/ncoffee/tesserae-preview
Environment=TESSERAE_READER_PORT=8091
Environment=READER_MODEL_DIR=/home/ncoffee/tesserae-v6-dev/evaluation/theme_benchmark/distill_train/runs/minilm/best
Environment=READER_THREADS=8
# Offline: a Hugging Face outage must never become a failed search on the site.
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
# The preview venv (venv/bin/python here) has no torch or transformers
# installed as of 2026-09-17; the v6-dev venv does. tesserae-embed.service
# already runs a script that lives outside its own venv's checkout from the
# v6-dev venv for the same reason, so this follows that precedent rather
# than installing anything into the preview venv. Point this at whichever
# venv has torch/transformers once the reader ships for real.
ExecStart=/home/ncoffee/tesserae-v6-dev/venv/bin/python /home/ncoffee/tesserae-preview/services/reader_server.py

# The checkpoint is 88MB and MiniLM is small, but this caps growth the same
# way tesserae-embed.service does: exceeded, it is killed and restarted
# rather than pushing anything else on the machine out of memory.
MemoryMax=4G
CPUWeight=50
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
