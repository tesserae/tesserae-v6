<div class="flex items-center gap-1 mb-3">
<button class="text-xs px-3 py-1 rounded bg-gray-700 text-white">Across the corpus</button>
<button class="text-xs px-3 py-1 rounded bg-gray-100 text-gray-600 hover:bg-gray-200">In this comparison</button>
</div>
<div class="mb-2">
