<button type="submit" disabled="" class="px-4 py-2 rounded bg-red-700 text-white text-sm font-medium hover:bg-red-800 disabled:opacity-40">Search</button>
</form>
<div class="mt-3 flex flex-wrap items-center gap-2 ">
<span class="text-xs text-gray-600">Search in</span>
<label class="text-xs px-2 py-0.5 rounded border cursor-pointer select-none bg-red-600 text-white border-red-600">
