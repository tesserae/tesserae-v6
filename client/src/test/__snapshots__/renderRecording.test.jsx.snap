<input type="checkbox" class="sr-only">English</label>
<label class="text-xs px-2 py-0.5 rounded border cursor-pointer select-none bg-white text-gray-700 border-gray-300 hover:bg-gray-50">
<input type="checkbox" class="sr-only">Coptic</label>
<label class="text-xs px-2 py-0.5 rounded border cursor-pointer select-none bg-white text-gray-700 border-gray-300 hover:bg-gray-50">
<input type="checkbox" class="sr-only">Persian</label>
<label class="text-xs px-2 py-0.5 rounded border cursor-pointer select-none bg-white text-gray-700 border-gray-300 hover:bg-gray-50">
