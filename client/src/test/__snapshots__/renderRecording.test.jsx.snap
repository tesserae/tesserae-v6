     unless the user manually ticks "Background graphics". */
  * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body {
    font-family: 'Crimson Pro', 'Noto Sans', 'Antinoou', 'Noto Sans Coptic', serif;
    color: #111; margin: 0; padding: 0;
