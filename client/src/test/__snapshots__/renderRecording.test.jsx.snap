<button type="button" aria-expanded="false" aria-controls="scope-panel-theme" class="shrink-0 text-red-700 hover:underline">Details</button>
</div>
</div>
<div class="mt-4 inline-flex rounded border border-gray-300 overflow-hidden text-sm">
<button aria-pressed="true" class="px-3 py-1.5 font-medium bg-red-700 text-white">Theme Search</button>
