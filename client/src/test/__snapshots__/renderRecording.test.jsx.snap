</path>
</svg>
</button>
</div>
</div>
<div class="flex flex-col sm:flex-row gap-2">
<input type="text" placeholder="a subject in plain words, such as fate and the plan of the gods" aria-label="Your question" class="flex-1 border rounded px-3 py-2 text-base sm:text-sm" value="">
<button type="submit" disabled="" class="rounded bg-red-700 px-4 py-2 text-sm font-medium text-white hover:bg-red-800 disabled:bg-gray-300">Go</button>
</div>
</form>
</div>
</div>
</main>
<footer class="bg-gray-100 border-t mt-8 py-4">
<div class="max-w-7xl mx-auto px-4 sm:px-6 text-center text-sm text-gray-500">
<p>Tesserae V6</p>
</div>
</footer>
</div>"
`;

