<h2 class="text-2xl font-bold text-gray-900">Coins</h2>
<p class="text-sm text-gray-600 mt-1 mb-4">Greek and Roman coin types, searchable by inscription and by the catalogue's description of what each side shows. The catalogues are listed under What this search does. In testing.</p>
<div class="rounded border border-gray-200 bg-white text-xs text-gray-600 mb-4" data-testid="scope-box-coins">
<div class="flex items-center gap-2 px-3 py-1.5">
<p class="min-w-0 flex-1 truncate" title="Searches the legends and catalogue descriptions of Greek and Roman coin types.">
<span class="font-semibold text-gray-700">What this search does.</span> Searches the legends and catalogue descriptions of Greek and Roman coin types.</p>
<button type="button" aria-expanded="false" aria-controls="scope-panel-coins" class="shrink-0 text-red-700 hover:underline">Details</button>
</div>
</div>
<form class="bg-white border border-gray-200 rounded-lg p-3 space-y-3">
<div class="flex flex-wrap gap-2 items-end">
<label class="flex-1 min-w-[12rem] text-xs text-gray-600">Search legends and descriptions<input placeholder="capricorn" class="mt-1 block w-full border border-gray-300 rounded px-2 py-1.5 text-sm text-gray-900" value="">
</label>
<button type="submit" class="px-3 py-1.5 text-sm rounded bg-red-700 text-white hover:bg-red-800">Search</button>
</div>
<div class="flex flex-wrap gap-2 items-end">
<label class="text-xs text-gray-600">Authority<select aria-label="Authority" class="mt-1 block max-w-[14rem] border border-gray-300 rounded px-2 py-1.5 text-sm text-gray-900">
<option value="">Any</option>
</select>
</label>
<label class="text-xs text-gray-600">Mint<select aria-label="Mint" class="mt-1 block max-w-[14rem] border border-gray-300 rounded px-2 py-1.5 text-sm text-gray-900">
<option value="">Any</option>
</select>
</label>
<label class="text-xs text-gray-600">Denomination<select aria-label="Denomination" class="mt-1 block max-w-[14rem] border border-gray-300 rounded px-2 py-1.5 text-sm text-gray-900">
<option value="">Any</option>
</select>
</label>
<label class="text-xs text-gray-600">Material<select aria-label="Material" class="mt-1 block max-w-[14rem] border border-gray-300 rounded px-2 py-1.5 text-sm text-gray-900">
<option value="">Any</option>
</select>
</label>
<label class="text-xs text-gray-600">Source<select aria-label="Source" class="mt-1 block max-w-[14rem] border border-gray-300 rounded px-2 py-1.5 text-sm text-gray-900">
<option value="">Any</option>
</select>
</label>
<label class="text-xs text-gray-600">From<span class="mt-1 flex gap-1">
<input inputmode="numeric" placeholder="year" aria-label="From" class="w-20 border border-gray-300 rounded px-2 py-1.5 text-sm text-gray-900" value="">
<select aria-label="From era" class="border border-gray-300 rounded px-1 py-1.5 text-sm text-gray-900">
<option value="BCE">BCE</option>
<option value="CE">CE</option>
</select>
</span>
</label>
<label class="text-xs text-gray-600">To<span class="mt-1 flex gap-1">
<input inputmode="numeric" placeholder="year" aria-label="To" class="w-20 border border-gray-300 rounded px-2 py-1.5 text-sm text-gray-900" value="">
<select aria-label="To era" class="border border-gray-300 rounded px-1 py-1.5 text-sm text-gray-900">
<option value="BCE">BCE</option>
<option value="CE">CE</option>
</select>
</span>
</label>
<label class="text-xs text-gray-600">Order<select aria-label="Order" class="mt-1 block border border-gray-300 rounded px-2 py-1.5 text-sm text-gray-900">
<option value="">Date</option>
</select>
</label>
</div>
</form>
<div class="mt-4">
<p class="text-xs text-gray-500 mb-2" data-testid="coins-total">0 coin types</p>
<p class="text-sm text-gray-600 bg-white border border-gray-200 rounded-lg p-4">No coin type matches. Try a shorter word or clear the filters.</p>
<div class="space-y-3">
</div>
</div>
</div>
</main>
<footer class="bg-gray-100 border-t mt-8 py-4">
<div class="max-w-7xl mx-auto px-4 sm:px-6 text-center text-sm text-gray-500">
<p>Tesserae V6</p>
</div>
</footer>
</div>"
`;

