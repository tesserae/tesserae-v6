<option value="">Any</option>
</select>
</label>
<label class="text-xs text-gray-600">Material<select aria-label="Material" class="mt-1 block max-w-[14rem] border border-gray-300 rounded px-2 py-1.5 text-sm text-gray-900">
<option value="">Any</option>
</select>
</label>
<label class="text-xs text-gray-600">From<span class="mt-1 flex gap-1">
<input inputmode="numeric" placeholder="year" aria-label="From" class="w-20 border border-gray-300 rounded px-2 py-1.5 text-sm text-gray-900" value="">
