<main class="max-w-7xl mx-auto px-3 sm:px-6 py-4 sm:py-6">
<div class="bg-white rounded-lg shadow p-4 sm:p-6">
<div class="rounded border border-gray-200 bg-white text-xs text-gray-600 mb-4" data-testid="scope-box-string">
<div class="flex items-center gap-2 px-3 py-1.5">
<p class="min-w-0 flex-1 truncate" title="Enter specific terms, optionally with wildcards (am*), phrases, or AND/OR operators.">
<span class="font-semibold text-gray-700">What this search does.</span> Enter specific terms, optionally with wildcards (am*), phrases, or AND/OR operators.</p>
<button type="button" aria-expanded="false" aria-controls="scope-panel-string" class="shrink-0 text-red-700 hover:underline">Details</button>
</div>
</div>
<div class="space-y-4">
<div>
<h2 class="text-xl font-bold mb-2">String Search</h2>
<p class="text-gray-600 text-sm">Search for words and patterns across the entire Latin corpus using wildcards and boolean operators.</p>
</div>
<div class="bg-gray-50 rounded-lg p-4 text-sm">
<h4 class="font-medium mb-2">Search Syntax</h4>
<ul class="space-y-1 text-gray-600">
<li>
<code class="bg-gray-200 px-1 rounded">*</code> matches any characters (e.g., <code>am*</code> finds amor, amicus, etc.)</li>
<li>
<code class="bg-gray-200 px-1 rounded">?</code> matches a single character (e.g., <code>am?r</code>)</li>
<li>
<code class="bg-gray-200 px-1 rounded">AND</code> both terms required (e.g., <code>amor AND bellum</code>)</li>
<li>
<code class="bg-gray-200 px-1 rounded">OR</code> either term (e.g., <code>rex OR regina</code>)</li>
<li>
<code class="bg-gray-200 px-1 rounded">~</code> proximity search (e.g., <code>amor ~ dolor</code>, within ~100 characters)</li>
<li>
<code class="bg-gray-200 px-1 rounded">"..."</code> exact phrase (e.g., <code>"arma virumque"</code>)</li>
</ul>
</div>
<div class="space-y-3">
<div class="flex gap-2">
<input type="text" placeholder="Enter search query..." class="flex-1 border rounded px-3 py-2" value="">
<button disabled="" class="px-4 py-2 bg-red-700 text-white rounded hover:bg-red-800 disabled:opacity-50">Search</button>
</div>
<div class="flex flex-wrap gap-4 text-sm">
<label class="flex items-center gap-2">
<input type="checkbox" class="rounded">Case sensitive</label>
<div class="flex items-center gap-2">
<span class="text-gray-600">Max results:</span>
<input type="number" class="w-20 border rounded px-2 py-1" value="200">
</div>
<div class="flex items-center gap-2">
<span class="text-gray-600">Limit to text:</span>
<input type="text" placeholder="e.g., vergil.aeneid" class="w-40 border rounded px-2 py-1" value="">
</div>
</div>
</div>
</div>
</div>
</main>
<footer class="bg-gray-100 border-t mt-8 py-4">
<div class="max-w-7xl mx-auto px-4 sm:px-6 text-center text-sm text-gray-500">
<p>Tesserae V6</p>
</div>
</footer>
</div>"
`;

