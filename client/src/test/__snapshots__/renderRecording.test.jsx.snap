exports[`SearchResults render recording > language cop, first ten rows 1`] = `
"<div class="space-y-4">
<div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-2 mb-4">
<div>
<h3 class="text-lg font-semibold text-gray-900" role="status" aria-live="polite">Top 13 of 4,821 Parallels</h3>
<p class="text-sm text-gray-500">Search completed in 3.2s | 756 source lines | 700 target lines</p>
<button title="Tessa reads all 13 parallels in this list and summarizes what they show, starting from the computed figures. You can widen the scope once the panel is open. Nothing runs until you click." class="text-sm text-red-700 hover:text-red-900 font-medium underline decoration-dotted underline-offset-4 mt-2">Ask Tessa: what does this evidence show?</button>
</div>
<div class="flex flex-col sm:flex-row gap-2">
<div class="flex items-center gap-2">
<button class="text-xs px-3 py-2 rounded whitespace-nowrap bg-amber-100 text-amber-700 hover:bg-amber-200">Show chart</button>
