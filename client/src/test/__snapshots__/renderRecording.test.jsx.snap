<main class="max-w-7xl mx-auto px-3 sm:px-6 py-4 sm:py-6">
<section aria-labelledby="start-here-heading" class="bg-white border border-gray-200 rounded-lg shadow-sm px-4 py-3 mb-4">
<div class="flex items-baseline justify-between gap-3 mb-1.5">
<h2 id="start-here-heading" class="text-sm font-semibold text-gray-700">What are you trying to do?</h2>
<button type="button" class="text-xs text-gray-500 hover:text-red-700 hover:underline">Skip</button>
</div>
<ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-0.5">
<li>
<a href="/ask-a-work" class="block text-sm py-0.5 text-gray-600 hover:text-red-700">
<span class="font-semibold text-gray-800">Search One Text:</span> <span>what one work says about a subject, in plain words</span>
</a>
</li>
<li>
<a href="/?tab=parallel" class="block text-sm py-0.5 text-gray-600 hover:text-red-700">
<span class="font-semibold text-gray-800">Phrase Search:</span> <span>the phrases two works share, ranked by how distinctive they are</span>
</a>
</li>
<li>
<a href="/?tab=line" class="block text-sm py-0.5 text-gray-600 hover:text-red-700">
<span class="font-semibold text-gray-800">Line Search:</span> <span>every line in the corpus where a phrase or a pair of words occurs</span>
</a>
</li>
<li>
<a href="/?tab=hapax" class="block text-sm py-0.5 text-gray-600 hover:text-red-700">
<span class="font-semibold text-gray-800">Rare Words:</span> <span>the rare words and word pairs two works share</span>
</a>
</li>
<li>
<a href="/theme-search" class="block text-sm py-0.5 text-gray-600 hover:text-red-700">
<span class="font-semibold text-gray-800">Theme Search:</span> <span>passages on a subject you describe in your own words, in any of the corpus languages</span>
</a>
</li>
<li>
<a href="/read" class="block text-sm py-0.5 text-gray-600 hover:text-red-700">
<span class="font-semibold text-gray-800">Reader:</span> <span>read a text with its echoes, translations and scholarship beside each passage</span>
</a>
</li>
<li>
<a href="/mentions" class="block text-sm py-0.5 text-gray-600 hover:text-red-700">
<span class="font-semibold text-gray-800">People &amp; Places:</span> <span>every line where a person, place or god is named, in Latin, Greek and English</span>
</a>
</li>
<li>
<a href="/inscriptions-papyri?profile=everything" class="block text-sm py-0.5 text-gray-600 hover:text-red-700">
<span class="font-semibold text-gray-800">Collections:</span> <span>inscriptions, papyri, events, coins and museum objects, switched on from the top row</span>
</a>
</li>
</ul>
</section>
<div class="max-w-6xl mx-auto p-6">
<div class="max-w-4xl">
<div class="flex items-center gap-2">
<h1 class="text-2xl font-semibold text-gray-900">Search One Text</h1>
<span class="rounded border border-amber-200 bg-amber-50 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-amber-800">Beta</span>
</div>
<p class="mt-1 text-sm text-gray-600">Pick a work and ask what it says about a subject.</p>
<div class="rounded border border-gray-200 bg-white text-xs text-gray-600 mt-3" data-testid="scope-box-ask_a_work">
<div class="flex items-center gap-2 px-3 py-1.5">
<p class="min-w-0 flex-1 truncate" title="Every passage in one work whose content matches a subject you describe, listed by how well it matches, with a strip showing where in the work they fall.">
<span class="font-semibold text-gray-700">What this search does.</span> Every passage in one work whose content matches a subject you describe, listed by how well it matches, with a strip showing where in the work they fall.</p>
<button type="button" aria-expanded="false" aria-controls="scope-panel-ask_a_work" class="shrink-0 text-red-700 hover:underline">Details</button>
</div>
</div>
<form class="mt-4 space-y-3">
<div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
<select aria-label="Language" class="w-full border rounded px-2 py-2 text-base sm:text-sm">
<option value="la">Latin</option>
<option value="grc">Greek</option>
<option value="en">English</option>
<option value="he">Hebrew</option>
<option value="cop">Coptic</option>
<option value="fa">Persian</option>
<option value="ur">Urdu</option>
</select>
<select class="sm:hidden w-full border rounded px-2 py-2 text-sm">
<option value="">Loading authors…</option>
</select>
<div class="relative hidden sm:block">
<input type="text" role="combobox" aria-label="Author" aria-expanded="false" aria-controls=":rID:-listbox" aria-autocomplete="list" placeholder="Loading authors…" class="w-full border rounded px-2 py-2 text-sm pr-7 focus:outline-none focus:ring-1 focus:ring-red-600" value="">
<button type="button" tabindex="-1" class="absolute right-1.5 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-auto">
<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
<path d="M2.5 4.5L6 8l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
</path>
</svg>
</button>
</div>
<select class="sm:hidden w-full border rounded px-2 py-2 text-sm">
<option value="">Work</option>
</select>
<div class="relative hidden sm:block">
<input type="text" role="combobox" aria-label="Work" aria-expanded="false" aria-controls=":rID:-listbox" aria-autocomplete="list" placeholder="Work" class="w-full border rounded px-2 py-2 text-sm pr-7 focus:outline-none focus:ring-1 focus:ring-red-600" value="">
<button type="button" tabindex="-1" class="absolute right-1.5 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-auto">
<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
<path d="M2.5 4.5L6 8l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
</path>
</svg>
</button>
</div>
</div>
<div class="flex flex-col sm:flex-row gap-2">
<input type="text" placeholder="a subject in plain words, such as fate and the plan of the gods" aria-label="Your question" class="flex-1 border rounded px-3 py-2 text-base sm:text-sm" value="">
<button type="submit" disabled="" class="rounded bg-red-700 px-4 py-2 text-sm font-medium text-white hover:bg-red-800 disabled:bg-gray-300">Go</button>
</div>
</form>
</div>
</div>
</main>
<footer class="bg-gray-100 border-t mt-8 py-4">
<div class="max-w-7xl mx-auto px-4 sm:px-6 text-center text-sm text-gray-500">
<p>Tesserae V6</p>
</div>
</footer>
</div>"
`;

