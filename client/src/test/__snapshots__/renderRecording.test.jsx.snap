<option value="CE">CE</option>
</select>
</span>
</label>
<label class="text-xs text-gray-600">To<span class="mt-1 flex gap-1">
<input inputmode="numeric" placeholder="year" aria-label="To" class="w-20 border border-gray-300 rounded px-2 py-1.5 text-sm text-gray-900" value="">
<select aria-label="To era" class="border border-gray-300 rounded px-1 py-1.5 text-sm text-gray-900">
<option value="BCE">BCE</option>
<option value="CE">CE</option>
</select>
</span>
</label>
<label class="text-xs text-gray-600">Order<select aria-label="Order" class="mt-1 block border border-gray-300 rounded px-2 py-1.5 text-sm text-gray-900">
<option value="">Date</option>
</select>
</label>
</div>
</form>
