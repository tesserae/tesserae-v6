<main class="max-w-7xl mx-auto px-3 sm:px-6 py-4 sm:py-6">
<div class="max-w-4xl mx-auto px-4 py-6">
<h2 class="text-2xl font-bold text-gray-900">Events</h2>
<p class="text-sm text-gray-600 mt-1 mb-4">Battles, sieges and treaties, each with the passages that tell of it, the inscriptions and papyri from nearby and from the same years, and the scholarship on those passages. In testing.</p>
<div class="rounded border border-gray-200 bg-white text-xs text-gray-600 mb-4" data-testid="scope-box-events">
<div class="flex items-center gap-2 px-3 py-1.5">
<p class="min-w-0 flex-1 truncate" title="Lists historical events with the passages that tell of them, the inscriptions and papyri from nearby and the scholarship.">
<span class="font-semibold text-gray-700">What this search does.</span> Lists historical events with the passages that tell of them, the inscriptions and papyri from nearby and the scholarship.</p>
<button type="button" aria-expanded="false" aria-controls="scope-panel-events" class="shrink-0 text-red-700 hover:underline">Details</button>
</div>
</div>
<form class="bg-white border border-gray-200 rounded-lg p-3 flex flex-wrap gap-2 items-end">
<div class="flex-1 min-w-[12rem]">
<div class="relative">
<label class="block text-xs text-gray-600">Search by name or place<span class="relative mt-1 block">
<input placeholder="Choose an event or type a name" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls=":rID:" class="block w-full border border-gray-300 rounded pl-2 pr-8 py-1.5 text-sm text-gray-900" value="">
<button type="button" tabindex="-1" aria-label="Show the list of events" class="absolute inset-y-0 right-0 px-2 text-gray-500 hover:text-gray-800">
<span aria-hidden="true">▾</span>
</button>
</span>
</label>
<ul id=":rID:" role="listbox" aria-label="Events" hidden="" class="absolute z-20 left-0 right-0 mt-1 bg-white border border-gray-200 rounded-lg shadow-lg max-h-96 overflow-auto">
</ul>
</div>
</div>
<label class="text-xs text-gray-600">Type<select class="mt-1 block border border-gray-300 rounded px-2 py-1.5 text-sm text-gray-900">
<option value="">All types</option>
</select>
</label>
<label class="text-xs text-gray-600">Century<select class="mt-1 block border border-gray-300 rounded px-2 py-1.5 text-sm text-gray-900">
<option value="">Any century</option>
</select>
</label>
<label class="text-xs text-gray-600">Order<select aria-label="Order" class="mt-1 block border border-gray-300 rounded px-2 py-1.5 text-sm text-gray-900">
<option value="name">Alphabetical</option>
<option value="date">By date, earliest first</option>
<option value="evidence">Most passages and documents</option>
</select>
</label>
<button type="submit" class="px-3 py-1.5 text-sm rounded bg-red-700 text-white hover:bg-red-800">Search</button>
<label class="w-full flex items-center gap-2 text-xs text-gray-600 pt-1">
<input type="checkbox" class="rounded">Include events with no passages or documents</label>
</form>
<div class="mt-4">
<p class="text-xs text-gray-500 mb-2" data-testid="events-total">0 events</p>
<p class="text-sm text-gray-600 bg-white border border-gray-200 rounded-lg p-4">No event matches. Try a shorter name or clear the filters.</p>
<ul class="space-y-2">
</ul>
</div>
</div>
</main>
<footer class="bg-gray-100 border-t mt-8 py-4">
<div class="max-w-7xl mx-auto px-4 sm:px-6 text-center text-sm text-gray-500">
<p>Tesserae V6</p>
</div>
</footer>
</div>"
`;

