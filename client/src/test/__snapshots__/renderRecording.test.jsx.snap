"<div class="min-h-screen bg-gray-100">
<header class="bg-gradient-to-r from-red-800 via-red-700 to-orange-600 shadow-lg">
<div class="max-w-7xl mx-auto px-3 sm:px-6 py-3 sm:py-5 flex justify-between items-center">
<button class="flex items-center gap-2 sm:gap-4 cursor-pointer hover:opacity-90 transition-opacity">
<img src="/tesserae-icon.jpg" alt="Tesserae" class="h-10 w-10 sm:h-14 sm:w-14 rounded-full">
<div class="text-left">
<h1 class="tesserae-title text-2xl sm:text-4xl font-semibold text-white tracking-wide">TESSERAE</h1>
<p class="text-orange-100 text-xs sm:text-sm mt-0.5 hidden sm:block">Literary and Historical Discovery</p>
</div>
</button>
<div class="flex items-center gap-2">
<button type="button" class="hidden sm:inline-flex items-center px-3 py-1.5 border border-white/70 text-white rounded text-sm hover:bg-white/10">Start here</button>
