exports[`SearchResults render recording > corpus panel on a pair that shares one word 1`] = `
"<div class="space-y-4">
<div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-2 mb-4">
<div>
<h3 class="text-lg font-semibold text-gray-900" role="status" aria-live="polite">Top 1 of 4,821 Parallels</h3>
<p class="text-sm text-gray-500">Search completed in 3.2s | 756 source lines | 700 target lines</p>
<button title="Tessa reads all 1 parallels in this list and summarizes what they show, starting from the computed figures. You can widen the scope once the panel is open. Nothing runs until you click." class="text-sm text-red-700 hover:text-red-900 font-medium underline decoration-dotted underline-offset-4 mt-2">Ask Tessa: what does this evidence show?</button>
</div>
<div class="flex flex-col sm:flex-row gap-2">
<div class="flex items-center gap-2">
<button class="text-xs px-3 py-2 rounded whitespace-nowrap bg-amber-600 text-white">Hide chart</button>
<button class="text-xs bg-amber-600 text-white px-3 py-2 rounded hover:bg-amber-700 whitespace-nowrap">Export CSV</button>
<button class="text-xs bg-amber-600 text-white px-3 py-2 rounded hover:bg-amber-700 whitespace-nowrap" title="Open print-friendly view; choose 'Save as PDF' in the print dialog.">Export PDF</button>
<button class="text-xs bg-gray-100 text-gray-600 px-3 py-2 rounded hover:bg-gray-200 whitespace-nowrap" title="Clear cached results and run the search again">Refresh results</button>
</div>
<div class="flex items-center gap-2">
<span class="text-xs sm:text-sm text-gray-600">Sort:</span>
<select class="border rounded px-2 py-1.5 text-xs sm:text-sm">
<option value="score">Score</option>
<option value="source_locus">Source Location</option>
<option value="target_locus">Target Location</option>
</select>
</div>
</div>
</div>
<div class="flex flex-col lg:flex-row-reverse gap-4 items-start">
